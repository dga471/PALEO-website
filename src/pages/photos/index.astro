---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, newestFirst } from '../../lib/format';
import { albumFolder, albumImages } from '../../lib/photos';

const albums = newestFirst(await getCollection('photos'), (a) => a.data.date).map((album) => {
  const folder = albumFolder(album.filePath);
  return { album, folder, cover: albumImages(folder)[0] };
});
---
<BaseLayout title="Photos">
  <h1>Photos</h1>
  <ul class="album-grid">
    {albums.map(({ album, folder, cover }) => (
      <li>
        <a href={`/photos/${folder}/`}>
          {cover && <Image src={cover.image} alt="" width={640} height={480} />}
          <h3>{album.data.title}</h3>
        </a>
        <div class="muted small">{formatDate(album.data.date)}</div>
      </li>
    ))}
  </ul>
</BaseLayout>
