---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { formatDate, newestFirst } from '../lib/format';
import hero from '../assets/placeholders/hero-thin-section.jpg';

const home = await getEntry('home', 'home');
const { Content: Intro } = await render(home!);

const news = newestFirst(await getCollection('news'), (n) => n.data.date).slice(0, 3);
const newsRendered = await Promise.all(news.map(async (item) => ({ item, Content: (await render(item)).Content })));
---
<BaseLayout description="PALEO: dark matter and neutrino searches with ancient minerals.">
  <div slot="band" class="hero-band">
    <Image src={hero} alt="" widths={[800, 1200, 1600, 2000]} sizes="100vw" loading="eager" />
    <div class="hero-band__scrim"></div>
    <span class="hero-band__chip">Placeholder image</span>
    <div class="hero-band__text">
      <div class="container">
        {home!.data.tagline && <p class="eyebrow">{home!.data.tagline}</p>}
        <h1>{home!.data.headline}</h1>
      </div>
    </div>
  </div>

  <section class="intro prose">
    <Intro />
  </section>

  <section>
    <h2>News</h2>
    <ul class="news-grid">
      {newsRendered.map(({ item, Content }) => (
        <li>
          <time class="eyebrow" datetime={item.data.date.toISOString().slice(0, 10)}>{formatDate(item.data.date)}</time>
          <h3>{item.data.title}</h3>
          <div class="prose"><Content /></div>
        </li>
      ))}
    </ul>
    <p><a href="/news/">All news</a></p>
  </section>
</BaseLayout>
