---
import type { ImageMetadata } from 'astro';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import photo from '../assets/collaboration-photo.png';

const institutions = await getCollection('institutions');
const members = await getCollection('members');

// Make the build fail loudly if a member points to an institution that does not exist.
for (const m of members) {
  if (!institutions.some((i) => i.data.short === m.data.institution)) {
    throw new Error(
      `data/members.yaml: "${m.data.name}" has institution "${m.data.institution}", ` +
        `which is not a "short" value in data/institutions.yaml.`,
    );
  }
}

// Institution logos live in src/assets/logos/ and are named in data/institutions.yaml.
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/logos/*.{png,jpg,jpeg,svg,webp}', { eager: true });
function logoFor(fileName: string): ImageMetadata {
  const hit = Object.entries(logoFiles).find(([path]) => path.endsWith('/' + fileName));
  if (!hit) throw new Error(`data/institutions.yaml: logo "${fileName}" was not found in src/assets/logos/.`);
  return hit[1].default;
}

const spokespersons = members.filter((m) => m.data.spokesperson);

// Marks after a name: * for senior members, † for institutional board members.
function marks(senior: boolean, board: boolean): string {
  return (senior ? '*' : '') + (board ? '†' : '');
}
---
<BaseLayout title="Collaboration">
  <h1>Collaboration</h1>

  <figure class="collab-photo">
    <Image src={photo} alt="Members of the PALEO collaboration" widths={[800, 1200, 1600, 2000]} sizes="(max-width: 70rem) 100vw, 70rem" />
  </figure>

  <p class="spokespersons">
    <strong>Spokespersons:</strong>{' '}
    {spokespersons.map((m, i) => (
      <>
        {m.data.email ? <a href={`mailto:${m.data.email}`}>{m.data.name}</a> : m.data.name}
        {i < spokespersons.length - 1 && ', '}
      </>
    ))}
  </p>

  <p class="muted">* senior member, † member of the institutional board.</p>

  {institutions.map(({ data: inst }) => {
    const here = members.filter((m) => m.data.institution === inst.short);
    const people = [...here.filter((m) => m.data.senior), ...here.filter((m) => !m.data.senior)];
    return (
      <section class="institution">
        <div class="institution__head">
          {inst.logo && (
            <a href={inst.url}><Image class="institution__logo" src={logoFor(inst.logo)} alt="" height={120} /></a>
          )}
          <h2>
            <a href={inst.url}>{inst.name}</a>
            <span class="country">{inst.country}</span>
          </h2>
        </div>
        <p class="members">
          {people.map((m, i) => (
            <>
              {m.data.url ? <a href={m.data.url}>{m.data.name}</a> : m.data.name}{marks(m.data.senior, m.data.board)}
              {i < people.length - 1 && ', '}
            </>
          ))}
        </p>
      </section>
    );
  })}
</BaseLayout>
