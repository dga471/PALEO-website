---
import { getCollection } from 'astro:content';
import Logo from './Logo.astro';
import { url } from '../lib/url';

const nav = await getCollection('nav');
const current = Astro.url.pathname;

function isCurrent(target: string): boolean {
  const full = url(target);
  if (full === url('/')) return current === full;
  return current.startsWith(full);
}
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href={url('/')} class="site-header__logo" aria-label="PALEO home"><Logo /></a>
    <nav aria-label="Main">
      <ul>
        {nav.map(({ data }) => (
          <li><a href={url(data.url)} aria-current={isCurrent(data.url) ? 'page' : undefined}>{data.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
